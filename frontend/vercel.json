{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://master-analytical-thinking-da-powerbiwd.onrender.com/api/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://master-analytical-thinking-da-powerbiwd.onrender.com/hubs/:path*"
    },
    {
      "source": "/((?!assets|pdfs|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pdfs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
